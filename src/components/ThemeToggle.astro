---
// Light/dark theme toggle. The initial theme is set before paint by the
// inline script in BaseLayout's <head> (no flash). This just flips it.
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-magnetic="0.25"
  aria-label="Toggle colour theme"
>
  <span class="theme-toggle__icon">
    <!-- Moon (shown in light mode → click for dark) -->
    <svg
      class="theme-icon theme-icon--moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
    <!-- Sun (shown in dark mode → click for light) -->
    <svg
      class="theme-icon theme-icon--sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    color: rgb(var(--color-ink));
    transition: color 0.4s ease;
    will-change: transform;
  }
  .theme-toggle__icon {
    position: relative;
    width: 20px;
    height: 20px;
  }
  .theme-icon {
    position: absolute;
    inset: 0;
    width: 20px;
    height: 20px;
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Light theme → show moon, hide sun */
  :global(:root:not([data-theme='dark'])) .theme-icon--sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  /* Dark theme → show sun, hide moon */
  :global(:root[data-theme='dark']) .theme-icon--moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
</style>

<script>
  import { onReady } from '../scripts/motion';

  function toggleTheme() {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.classList.add('theme-transition');
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* ignore */
    }
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', next === 'dark' ? '#0c110d' : '#f4f5ee');
    window.setTimeout(() => root.classList.remove('theme-transition'), 500);
  }

  function initThemeToggles() {
    // Bind every instance (top bar + floating bar).
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.ready) return;
      btn.dataset.ready = '1';
      btn.addEventListener('click', toggleTheme);
    });
  }

  onReady(initThemeToggles);
</script>
