---
import { site, nav, socials } from '../data/site';
import ContactCta from './ContactCta.astro';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<ContactCta />

<footer class="border-t border-line bg-bg">
  <!-- Footer grid -->
  <div class="container-x grid gap-10 border-t border-line py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <Logo class="text-2xl" />
      <p class="mt-3 max-w-sm text-sm text-muted">{site.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow mb-4">Menu</p>
      <ul class="space-y-2 text-sm">
        {nav.map((i) => (<li><a href={i.href} class="link-underline text-muted hover:text-ink">{i.label}</a></li>))}
      </ul>
    </nav>

    <div>
      <p class="eyebrow mb-4">Elsewhere</p>
      <ul class="space-y-2 text-sm">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="link-underline text-muted hover:text-ink">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container-x flex flex-col justify-between gap-2 border-t border-line py-6 text-xs text-muted md:flex-row">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>{site.location}</p>
  </div>
</footer>
