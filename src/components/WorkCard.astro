---
import type { CollectionEntry } from 'astro:content';
import Reveal from './Reveal.astro';

interface Props {
  project: CollectionEntry<'work'>;
  large?: boolean;
}
const { project, large = false } = Astro.props;
const { data } = project;
---

<Reveal>
  {/* Case-study detail pages aren't built yet — cards are non-interactive for
      now. Re-wrap in <a href={`/work/${project.id}`} class="group block"
      data-cursor-label="View"> (and restore the ↗ badge + group-hover cues)
      once /work/[slug] ships. */}
  <div class="block">
    <div class="relative overflow-hidden bg-surface" style={`--proj-accent:${data.accent ?? 'var(--color-accent)'}`}>
      <div class={`overflow-hidden ${large ? 'aspect-[16/10]' : 'aspect-[4/3]'}`}>
        <img
          src={data.banner}
          alt={`${data.client} — ${data.title}`}
          loading="lazy"
          decoding="async"
          data-parallax
          class="h-[112%] w-full -translate-y-[6%] object-cover"
        />
      </div>
    </div>

    <div class="mt-5 flex items-start justify-between gap-4">
      <div>
        <h3 class="text-display-sm font-bold">
          {data.client}
        </h3>
        <p class="mt-1 text-muted">{data.summary}</p>
      </div>
      <span class="shrink-0 whitespace-nowrap border border-line px-3 py-1 text-xs text-muted">
        {data.category}
      </span>
    </div>
  </div>
</Reveal>
