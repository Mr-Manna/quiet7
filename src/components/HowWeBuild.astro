---
// "How we build" — immersive dark section: a living WebGL field behind a
// big statement and four frosted-glass pillar cards that light up on hover.
import WebGLField from './WebGLField.astro';
import BracketLabel from './BracketLabel.astro';
import Icon from './Icon.astro';
import Reveal from './Reveal.astro';

const pillars = [
  {
    no: '01',
    icon: 'brand',
    title: 'Brand',
    body: 'Strategy and identity that give the work a spine — a story people can actually repeat.',
  },
  {
    no: '02',
    icon: 'web',
    title: 'Web',
    body: 'Interfaces designed for clarity, not decoration. Every screen has to earn its place.',
  },
  {
    no: '03',
    icon: 'build',
    title: 'Build',
    body: 'Engineering that ships exactly what the design promised — fast, accessible, durable.',
  },
  {
    no: '04',
    icon: 'scale',
    title: 'Scale',
    body: 'Systems and documentation that keep holding up as the team and the product grow.',
  },
];
---

<section class="hwb">
  <WebGLField class="hwb__canvas" />
  <div class="container-x hwb__inner">
    <div class="hwb__head">
      <Reveal class="hwb__eyebrow"><BracketLabel text="How we build" /></Reveal>
      <Reveal as="h2" class="hwb__title statement rp__statement">Built to be <em>understood.</em></Reveal>
      <Reveal as="p" class="hwb__lead">
        One senior team across strategy, design and engineering — so nothing gets lost in
        translation between what we imagine and what we ship.
      </Reveal>
    </div>

    <div class="hwb__grid">
      {
        pillars.map((p, i) => (
          <Reveal>
            <article class="hwb__card" data-parallax={i % 2 === 0 ? '-6' : '-16'}>
              <span class="hwb__no">{p.no}</span>
              <span class="hwb__icon">
                <Icon name={p.icon} class="h-6 w-6" />
              </span>
              <h3 class="hwb__card-title">{p.title}</h3>
              <p class="hwb__card-body">{p.body}</p>
              <span class="hwb__line" aria-hidden="true" />
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Dark panel: restore the BRIGHT lime for accent text (7.3:1 on forest).
     The deepened accent-text token is for light backgrounds only. */
  .hwb { --color-accent-text: var(--color-accent); }

  .hwb {
    position: relative;
    overflow: hidden;
    background: rgb(var(--forest));
    color: rgb(var(--forest-ink));
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .hwb__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hwb__burst {
    position: absolute;
    top: -9rem;
    right: -11rem;
    width: clamp(20rem, 42vw, 42rem);
    opacity: 0.16;
    z-index: 0;
    pointer-events: none;
  }
  .hwb__inner {
    position: relative;
    z-index: 1;
  }

  /* ── Head ── */
  .hwb__head { max-width: 46rem; }
  .hwb__eyebrow { margin-bottom: 1.25rem; font-size: 0.8rem; }
  .hwb__eyebrow :global(.brk) { color: rgb(var(--forest-ink)); }
  .hwb__title {
    font-family: 'Space Grotesk Variable', sans-serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hwb__title em {
    font-style: normal;
    color: rgb(var(--color-accent-text));
  }
  .hwb__lead {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgb(var(--forest-ink) / 0.7);
  }

  /* ── Pillar cards ── */
  .hwb__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  @media (min-width: 640px) {
    .hwb__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .hwb__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .hwb__card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 2.5vw, 2rem);
    border-radius: 14px;
    border: 1px solid rgb(var(--forest-ink) / 0.14);
    background: rgb(var(--forest-ink) / 0.06);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s ease,
      background-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .hwb__card:hover {
    transform: translateY(-6px);
    border-color: rgb(var(--color-accent) / 0.5);
    background: rgb(var(--forest-ink) / 0.1);
    box-shadow: 0 18px 50px -20px rgb(var(--color-accent) / 0.4);
  }

  .hwb__no {
    font-family: 'Space Grotesk Variable', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: rgb(var(--color-accent-text));
  }
  .hwb__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-top: 1.5rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--forest-ink) / 0.18);
    color: rgb(var(--forest-ink));
    transition:
      background-color 0.45s ease,
      color 0.45s ease,
      border-color 0.45s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hwb__card:hover .hwb__icon {
    background: rgb(var(--color-accent));
    color: rgb(var(--forest));
    border-color: rgb(var(--color-accent-text));
    transform: scale(1.06) rotate(-6deg);
  }
  .hwb__card-title {
    margin-top: 1.5rem;
    font-family: 'Space Grotesk Variable', sans-serif;
    font-weight: 700;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    letter-spacing: -0.02em;
  }
  .hwb__card-body {
    flex: 1;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(var(--forest-ink) / 0.68);
  }
  .hwb__line {
    position: relative;
    display: block;
    margin-top: 1.5rem;
    height: 2px;
    width: 100%;
    overflow: hidden;
    background: rgb(var(--forest-ink) / 0.12);
  }
  .hwb__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hwb__card:hover .hwb__line::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hwb__card,
    .hwb__icon,
    .hwb__line::after {
      transition: none;
    }
    .hwb__card:hover { transform: none; }
  }
</style>
