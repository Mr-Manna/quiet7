---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { site, socials } from '../data/site';
import { contactFaqs } from '../data/faqs';

const budgets = ['< $10k', '$10k–$25k', '$25k–$50k', '$50k–$100k', '$100k+'];
const interests = ['Branding', 'Web', 'Product design', 'Development', 'Not sure yet'];
---

<BaseLayout title="Contact" description="Tell us about your project. We reply within two working days.">
  <section class="container-x pt-40 pb-16 md:pt-48">
    <Reveal class="eyebrow mb-6"><span class="h-px w-8 bg-muted"></span>Contact</Reveal>
    <h1 class="max-w-4xl text-display-lg font-bold" data-statement>Let’s build something quiet.</h1>
    <Reveal as="p" class="mt-8 max-w-xl text-lg text-muted">
      Tell us a little about what you’re working on. We read every message and reply within
      two working days.
    </Reveal>
  </section>

  <section class="container-x pb-24 grid gap-16 md:grid-cols-12">
    <!-- Details -->
    <Reveal class="md:col-span-4 space-y-10">
      <div>
        <p class="eyebrow mb-3">Email</p>
        <a href={`mailto:${site.email}`} class="link-underline text-lg">{site.email}</a>
      </div>
      <div>
        <p class="eyebrow mb-3">Phone</p>
        <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="link-underline text-lg">{site.phone}</a>
      </div>
      <div>
        <p class="eyebrow mb-3">Studio</p>
        <p class="text-lg">{site.location}</p>
        <p class="text-muted">{site.address}</p>
      </div>
      <div>
        <p class="eyebrow mb-3">Elsewhere</p>
        <ul class="space-y-1">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="link-underline text-muted hover:text-ink">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </Reveal>

    <!-- Form -->
    <Reveal class="md:col-span-7 md:col-start-6">
      <!--
        Placeholder form. To make it live, create a form on Formspree
        (or similar) and set FORM_ENDPOINT below to your endpoint URL.
        Until then, submissions fall back to opening the user's mail client.
      -->
      <form
        id="contact-form"
        class="space-y-8"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="grid gap-8 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium">Name</span>
            <input name="name" type="text" required class="form-input" placeholder="Your name" />
          </label>
          <label class="block">
            <span class="text-sm font-medium">Email</span>
            <input name="email" type="email" required class="form-input" placeholder="you@company.com" />
          </label>
        </div>

        <label class="block">
          <span class="text-sm font-medium">Company</span>
          <input name="company" type="text" class="form-input" placeholder="Company (optional)" />
        </label>

        <fieldset>
          <legend class="text-sm font-medium">What do you need?</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {interests.map((i) => (
              <label class="chip">
                <input type="checkbox" name="interest" value={i} class="sr-only" />
                <span>{i}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-medium">Budget</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {budgets.map((b) => (
              <label class="chip">
                <input type="radio" name="budget" value={b} class="sr-only" />
                <span>{b}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="block">
          <span class="text-sm font-medium">Project details</span>
          <textarea name="message" rows="5" required class="form-input resize-none" placeholder="Tell us what you’re building…"></textarea>
        </label>

        <button type="submit" class="btn-primary">Send message <span aria-hidden="true">→</span></button>
        <p id="form-note" class="text-sm text-muted"></p>
      </form>
    </Reveal>
  </section>

  <!-- FAQ -->
  <section class="container-x section border-t border-line">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <SectionHeading index="02" eyebrow="Questions" title="Before you send that." />
      </div>
      <div class="md:col-span-8">
        <FAQAccordion items={contactFaqs} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form-input {
    @apply mt-2 w-full border-0 border-b border-line bg-transparent py-3 text-lg outline-none transition-colors placeholder:text-muted/60 focus:border-ink;
  }
  .chip {
    @apply cursor-pointer border border-line px-4 py-2 text-sm text-muted transition-colors;
  }
  .chip:has(input:checked) {
    @apply border-ink bg-ink text-bg;
  }
</style>

<script>
  import { onReady } from '../scripts/motion';

  // Formspree-ready progressive enhancement. Set this to your endpoint
  // (e.g. 'https://formspree.io/f/xxxxxx') to submit via fetch instead
  // of the mailto fallback.
  const FORM_ENDPOINT = '';

  function initForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const note = document.getElementById('form-note');
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      if (!FORM_ENDPOINT) return; // let native mailto action handle it
      e.preventDefault();
      if (note) note.textContent = 'Sending…';
      try {
        const res = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          if (note) note.textContent = 'Thanks — we’ll be in touch within two working days.';
        } else {
          if (note) note.textContent = 'Something went wrong. Please email us directly.';
        }
      } catch {
        if (note) note.textContent = 'Something went wrong. Please email us directly.';
      }
    });
  }

  initForm();
  onReady(initForm);
</script>
