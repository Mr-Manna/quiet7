---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';

const articles = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Journal"
  description="Writing on design, art and visual communication from quiet seven."
>
  <section class="container-x pt-40 pb-16 md:pt-48">
    <Reveal class="eyebrow mb-6"><span class="h-px w-8 bg-muted"></span>Journal</Reveal>
    <h1 class="max-w-4xl text-display-lg font-bold" data-statement>
      Notes on design, art & visual communication.
    </h1>
  </section>

  <section class="container-x section border-t border-line">
    <ul class="divide-y divide-line border-y border-line">
      {
        articles.map((a) => (
          <li>
            <Reveal>
              <a href={`/journal/${a.id}`} class="group grid gap-3 py-8 md:grid-cols-12 md:items-baseline md:gap-6">
                <span class="text-xs font-medium uppercase tracking-[0.18em] text-accent-text md:col-span-2">
                  {a.data.category}
                </span>
                <div class="md:col-span-7">
                  <h2 class="text-display-sm font-bold transition-colors duration-300 group-hover:text-accent-text">
                    {a.data.title}
                  </h2>
                  <p class="mt-2 max-w-xl text-muted">{a.data.excerpt}</p>
                </div>
                <span class="text-sm text-muted md:col-span-2">{fmt(a.data.date)}</span>
                <span class="text-sm tabular-nums text-muted md:col-span-1 md:text-right">{a.data.readTime}</span>
              </a>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
